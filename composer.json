{
  "name": "byjg/wordnumber",
  "description": "Convert numeric values into their word representations in multiple languages.",
  "require": {
    "php": ">=8.3 <8.7"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\WordNumber\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT",
  "prefer-stable": true,
  "minimum-stability": "dev"
}
